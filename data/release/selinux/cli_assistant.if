## <summary>policy for cli_assistant</summary>

########################################
## <summary>
##	Execute cli_assistant_exec_t in the cli_assistant domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to transition.
##	</summary>
## </param>
interface(`cli_assistant_domtrans',`
	gen_require(`
		type cli_assistant_t, cli_assistant_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, cli_assistant_exec_t, cli_assistant_t)
')

########################################
## <summary>
##	Execute cli_assistant in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
interface(`cli_assistant_exec',`
	gen_require(`
		type cli_assistant_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, cli_assistant_exec_t)
')

########################################
## <summary>
##	Read cli_assistant configuration files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
interface(`cli_assistant_read_conf',`
	gen_require(`
		type cli_assistant_etc_rw_t;
	')

	allow $1 cli_assistant_etc_rw_t:dir list_dir_perms;
	read_files_pattern($1, cli_assistant_etc_rw_t, cli_assistant_etc_rw_t)
	files_search_etc($1)
')

########################################
## <summary>
##	Manage cli_assistant lib files and directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
interface(`cli_assistant_manage_lib',`
	gen_require(`
		type cli_assistant_var_lib_rw_t;
	')

	files_search_var_lib($1)
	manage_dirs_pattern($1, cli_assistant_var_lib_rw_t, cli_assistant_var_lib_rw_t)
	manage_files_pattern($1, cli_assistant_var_lib_rw_t, cli_assistant_var_lib_rw_t)
')

########################################
## <summary>
##	Send and receive messages from cli_assistant over D-Bus.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
interface(`cli_assistant_dbus_chat',`
	gen_require(`
		type cli_assistant_t;
		class dbus send_msg;
	')

	allow $1 cli_assistant_t:dbus send_msg;
	allow cli_assistant_t $1:dbus send_msg;
')
